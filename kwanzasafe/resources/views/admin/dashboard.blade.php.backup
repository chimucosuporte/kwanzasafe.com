    .ad-mobile-toggle { display:none; background:none; border:1px solid #e5e5e5; padding:0.5rem; border-radius:8px; cursor:pointer; }

    .ad-content { flex:1; padding:1.5rem; }
    .ad-flash { padding:0.875rem 1.125rem; border-radius:10px; font-size:0.85rem; margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem; }
    .ad-flash.success { background:#d1f2e0; border:1px solid #a7f3d0; color:#007a34; }
    .ad-flash.error { background:#fee2e2; border:1px solid #fca5a5; color:#991b1b; }

    /* ============ STATS ============ */
    .ad-stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem; margin-bottom:1.5rem; }
    .ad-stat {
